# ===========================================================================
# NorthStar 后端环境变量模板
#
# 复制为 .env（已被 .gitignore 忽略）后填入真实值；
# 生产环境建议用 systemd 的 EnvironmentFile / Environment 注入，而不是把 .env 放到 jar 旁边。
#
# 没有默认值的项属于「缺失即启动失败」，这是刻意的：
# 见 src/main/java/.../config/SecurityStartupValidator.java
# ===========================================================================

# --- 运行 profile（生产必须显式设置）--------------------------------------
# prod：生产（ddl-auto=validate、CORS 只允许正式域名、内测严格模式）
# local：本机开发（连本机或开发库，允许 ddl-auto=update）
SPRING_PROFILES_ACTIVE=prod

# --- 数据库 ---------------------------------------------------------------
DB_URL=jdbc:mysql://127.0.0.1:3306/web?serverTimezone=Asia/Shanghai&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=web
DB_PASSWORD=change-me
# 生产建议显式锁死，避免误用 Hibernate 自动改表：validate / none
DDL_AUTO=validate

# --- Redis ---------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# --- JWT：必须 64 位随机字符串，生成方式 openssl rand -base64 48 -----------
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_EXPIRATION=86400000

# --- 管理员 ---------------------------------------------------------------
ADMIN_USERNAMES=JeffreyMing

# --- MC 桥接（需与 northstar-web-bridge 的 config.yml 保持一致）----------
NORTHSTAR_BRIDGE_SECRET=change-me-to-a-32-byte-random-token
# 只允许 MC 服务器出口 IP 上报，支持单个 IP 与 IPv4 CIDR，逗号分隔；留空=不限制
BRIDGE_ALLOWED_IPS=

# --- 邮件（网易 163 企业/个人邮箱 SMTP）----------------------------------
MAIL_HOST=smtp.yeah.net
MAIL_PORT=465
MAIL_USERNAME=northstar2026@yeah.net
MAIL_PASSWORD=change-me

# --- 内测校验 -------------------------------------------------------------
# 生产保持 true：白名单条目未绑定游戏ID 时一律不放行
VERIFY_REQUIRE_MC_ID=true
VERIFY_RATE_LIMIT_PER_MINUTE=60

# --- 服务与反代 -----------------------------------------------------------
SERVER_PORT=8080
# 经过 OpenResty / Nginx 反代时保持 framework；端口裸暴露时设为 none
FORWARD_HEADERS_STRATEGY=framework

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=https://northstar.mingpixel.net

# --- 安全基线 -------------------------------------------------------------
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE_SECONDS=2592000
FORCE_HTTPS=false
SECURITY_STRICT_DEV_PROFILE=true

# --- 认证限流 / 验证码 ----------------------------------------------------
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_CODE_TTL_SECONDS=120
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_FAIL_LIMIT=10
AUTH_SEND_CODE_IP_LIMIT=5
AUTH_RESET_IP_LIMIT=10

# --- 公开接口 -------------------------------------------------------------
PUBLIC_BETA_CHECK_LIMIT_PER_MINUTE=30
PUBLIC_AVATAR_LIMIT_PER_MINUTE=60
# 是否允许用自增主键查询公开战绩（默认关闭，防遍历）
PUBLIC_NUMERIC_ID_LOOKUP=false
